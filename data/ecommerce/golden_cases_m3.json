    "numbers": [56057, 27212],
    "conclusion_must_contain": ["直通车", "搜索"],
    "must_call_tools": ["query_metrics"],
    "must_say": []
   }
  },
  {
   "id": "M3-3-跨源转化率",
   "question": "近7天每天的转化率是多少？",
   "session": "new",
   "expect": {
    "numbers": [],
